@page "/categories"
@attribute [Authorize]
@inject ICategoryService CategoryService

<PageTitle>Categories</PageTitle>

<h1>Categories</h1>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}

<EditForm Model="_form" OnValidSubmit="SaveAsync" class="row g-2 align-items-end mb-4">
    <DataAnnotationsValidator />
    <div class="col-md-4">
        <label class="form-label">Name</label>
        <InputText class="form-control" @bind-Value="_form.Name" />
        <ValidationMessage For="() => _form.Name" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">@(_editingId is null ? "Add" : "Save")</button>
    </div>
</EditForm>

@if (_categories is null)
{
    <p><em>Loading…</em></p>
}
else
{
    <ul class="list-group">
        @foreach (var c in _categories)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                @c.Name
                <span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditCategory(c)">Edit</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(c.Id)">Delete</button>
                </span>
            </li>
        }
    </ul>
}

@code {
    private List<Category>? _categories;
    private Category _form = new();
    private int? _editingId;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _categories = await CategoryService.GetAllAsync();
        }
        catch (ServiceException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void EditCategory(Category c)
    {
        _editingId = c.Id;
        _form = new Category { Id = c.Id, Name = c.Name };
    }

    private async Task SaveAsync()
    {
        try
        {
            _errorMessage = null;
            if (_editingId is null)
                await CategoryService.AddAsync(_form);
            else
                await CategoryService.UpdateAsync(_form);

            await LoadAsync();
            _editingId = null;
            _form = new Category();
        }
        catch (ServiceException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task DeleteAsync(int id)
    {
        try
        {
            await CategoryService.DeleteAsync(id);
            await LoadAsync();
        }
        catch (ServiceException ex)
        {
            _errorMessage = ex.Message;
        }
    }
}
